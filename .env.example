# Trek matcher (/api/match) and the ask panel on each departure card.
#
# OPTIONAL. Without it the section still works: the route falls straight through
# to the deterministic matcher in src/lib/matcher-fallback.ts, which runs the
# same five questions against the same dataset and applies the same refusals.
# Set it to turn on the assistant path.
#
# Set it in Vercel under Project → Settings → Environment Variables, not here —
# this file is committed and must never hold a real key.
ANTHROPIC_API_KEY=
